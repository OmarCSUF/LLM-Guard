# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/
.env

# ── Run-time output (regenerated by the scripts) ─────────────────────────────
# Only the top-level logs/ directory: results/final_eval_20260926/logs/ is part
# of the recorded study and stays tracked.
/logs/
.gradio/

# ── Data that is downloaded or rebuilt (see data/README.md) ──────────────────
# The contents are ignored; the directories and any .gitkeep inside them are
# kept, so a fresh clone has the folders the scripts write to.
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep
/data/processed/**
!/data/processed/**/
!/data/processed/**/.gitkeep
/data/benchmarks/**
!/data/benchmarks/**/
!/data/benchmarks/**/.gitkeep
/data/distillation_pool*/**
!/data/distillation_pool*/**/
!/data/distillation_pool*/**/.gitkeep
/data/benchmarks_learner/**
!/data/benchmarks_learner/**/
!/data/benchmarks_learner/**/.gitkeep
/data/benchmarks_parity/**
!/data/benchmarks_parity/**/
!/data/benchmarks_parity/**/.gitkeep
/data/benchmarks_rebuild_check/**
!/data/benchmarks_rebuild_check/**/
!/data/benchmarks_rebuild_check/**/.gitkeep

# Kept under version control on purpose (no blanket rule may ignore them):
#   data/benchmarks_final/   the 3,453-prompt final test set and its manifest
#   data/README.md, data/LICENSES.md, data/**/.gitkeep
#   results/                 the pre-registered study, development and repeat-study results
#   artifacts/               the four pinned Layer-1 checkpoints (*.safetensors, *.joblib included)
#   figures/                 the paper figures

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.ipynb_checkpoints/
